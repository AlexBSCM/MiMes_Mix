rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users — search (read any), write only own profile
    match /users/{login} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // Calls — both participants need full access
    match /calls/{callId} {
      allow read, write: if request.auth != null;

      // Nested collections (offer, answer, candidates)
      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }

    // Chats — participants read/write messages
    match /chats/{chatId} {
      allow read, write: if request.auth != null;

      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
