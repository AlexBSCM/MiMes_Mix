rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users — search (read any), write any (for now)
    // TODO: add admin-only delete via request.auth.uid when Firebase Auth is set up
    match /users/{login} {
      allow read, write: if request.auth != null;
    }

    // Friend requests — both parties need access
    match /friend_requests/{requestId} {
      allow read, write: if request.auth != null;
    }

    // Calls — both participants need full access
    match /calls/{callId} {
      allow read, write: if request.auth != null;

      // Nested collections (offer, answer, candidates)
      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }

    // Chats — participants read/write messages
    match /chats/{chatId} {
      allow read, write: if request.auth != null;

      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
